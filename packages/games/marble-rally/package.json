{
  "name": "@sg/game-marble-rally",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Game module for marble-rally: pure logic, bot, scenarios, content loaders and stage/controller clients.",
  "exports": {
    ".": "./src/index.ts",
    "./logic": "./src/logic/index.ts",
    "./client": "./src/client/index.ts",
    "./scenarios": "./src/scenarios.ts",
    "./preview": "./src/preview/track-preview.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --passWithNoTests",
    "tracks:author": "node --import tsx test/author-tracks.ts",
    "tracks:check": "node --import tsx test/track-lab.ts check",
    "tracks:preview": "node --import tsx test/track-lab.ts preview"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "@sg/audio": "workspace:*",
    "@sg/engine": "workspace:*",
    "@sg/render": "workspace:*",
    "@sg/shared": "workspace:*",
    "@sg/ui": "workspace:*",
    "preact": "^10.29.8",
    "three": "0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "happy-dom": "^20.14.5"
  }
}
