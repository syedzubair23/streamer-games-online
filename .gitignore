# dependencies
node_modules/
.pnpm-store/

# build output
dist/
dist-ssr/
*.tsbuildinfo
.vite/
coverage/

# harness output: everything under artifacts/ is regenerated, except critic reports
/artifacts/*
!/artifacts/critic/

# playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# local data
*.sqlite
*.sqlite-journal
*.db
.env
.env.*
!.env.example

# logs and OS/editor noise
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- public-repo safety ---
# third-party reference images (press kits / store screenshots) are for local critic use only: never publish
/docs/references/**/*.png
/docs/references/**/*.jpg
/docs/references/**/*.jpeg
/docs/references/**/*.webp
# our own golden screenshots are fine to publish
!/docs/references/_style/golden/
!/docs/references/_style/golden/**
# critic reports may embed local paths/screenshots; keep JSON only
/artifacts/critic/**/*.png
# secrets / keys / local config
*.pem
*.key
*.p12
*.pfx
id_rsa*
.npmrc
secrets/
*.secret.*
.claude/settings.local.json
/artifacts/critic/_calibration/20*.json
# critic inputs laid out by `pnpm critic:prep` (clips, stream JPEGs) stay local like the PNGs
/artifacts/critic/**/*.webm
/artifacts/critic/**/*.jpg
